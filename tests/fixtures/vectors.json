    {
      "name": "A and X then B and Y",
      "args": [
        "A\n\nB",
        "X\n\nY"
      ],
      "expected": {
        "rows": [
          {
            "left": {
              "text": "A",
              "line": 0
            },
            "right": {
              "text": "X",
              "line": 0
            }
          },
          {
            "left": {
              "text": "B",
              "line": 2
            },
            "right": {
              "text": "Y",
              "line": 2
            }
          }
        ],
        "error": null
      }
    },
    {
